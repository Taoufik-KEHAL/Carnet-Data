---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.entryNumber - a.data.entryNumber);

const pillarLabels: Record<string, string> = {
  'mlops': 'MLOps',
  'ml-fondamentaux': 'ML fondamentaux',
  'big-data-cloud': 'Big Data & Cloud',
  'risk-modeling': 'Risk modeling',
  'data-analysis': 'Data Analysis',
};
const dateFmt = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<BaseLayout
  title="Carnet Data"
  description="Notes de terrain sur le Machine Learning, le MLOps, le Big Data et la modélisation du risque — en français, pour praticiens."
>
  <section class="hero">
    <p class="eyebrow">Carnet de bord — entrées {String(posts.length).padStart(3, '0')} et suivantes</p>
    <h1>Le Machine Learning tel qu'on le pratique, pas tel qu'on le vend.</h1>
    <p class="hero__dek">
      Des notes techniques en français sur le MLOps, le Big Data et la modélisation du risque —
      écrites pour des praticiens, par quelqu'un qui les met en production.
    </p>
  </section>

  <AdSlot />

  <section class="entries">
    {posts.map((post) => (
      <a class="entry" href={`/blog/${post.id}/`}>
        <span class="entry__stamp">#{String(post.data.entryNumber).padStart(3, '0')}</span>
        <div class="entry__body">
          <p class="entry__meta">{pillarLabels[post.data.pillar]} · {dateFmt(post.data.publishDate)}</p>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </div>
      </a>
    ))}
    {posts.length === 0 && (
      <p class="empty">Aucune entrée publiée pour l'instant. La première arrive bientôt.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hero { margin-bottom: 2em; }
  .hero h1 { margin-top: 0.3em; }
  .hero__dek {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .entries {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 1em;
  }
  .entry {
    display: flex;
    gap: 18px;
    padding: 20px;
    border: 1px solid var(--paper-line);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }
  .entry:hover { border-color: var(--red); }
  .entry__stamp {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--red);
    flex-shrink: 0;
    padding-top: 3px;
  }
  .entry__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--teal);
    margin: 0 0 0.3em;
  }
  .entry h2 { font-size: 1.2rem; margin: 0 0 0.3em; }
  .entry p:last-child { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .empty { color: var(--ink-soft); font-style: italic; }
</style>
