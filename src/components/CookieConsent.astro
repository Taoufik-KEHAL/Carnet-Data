---
---
<div id="cookie-consent" class="cookie-consent" hidden>
  <p>
    Ce site utilise des cookies pour la mesure d'audience (Google Analytics) et, une fois les
    publicités activées, pour la personnalisation publicitaire. Détails dans la
    <a href="/politique-de-confidentialite">politique de confidentialité</a>.
  </p>
  <div class="cookie-consent__actions">
    <button id="cookie-refuse" type="button" class="cookie-consent__btn cookie-consent__btn--ghost">Refuser</button>
    <button id="cookie-accept" type="button" class="cookie-consent__btn">Accepter</button>
  </div>
</div>

<style>
  .cookie-consent[hidden] {
    display: none;
  }
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--card);
    border-top: 1px solid var(--paper-line);
    padding: 18px calc(min(64px, 8vw) + 32px) 18px 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  }
  .cookie-consent p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .cookie-consent a { color: var(--teal); }
  .cookie-consent__actions {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }
  .cookie-consent__btn {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    padding: 10px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  .cookie-consent__btn--ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--paper-line);
  }
  .cookie-consent__btn:hover { border-color: var(--red); }
  @media (max-width: 640px) {
    .cookie-consent {
      padding: 16px 20px;
      flex-direction: column;
      align-items: stretch;
    }
    .cookie-consent__actions { justify-content: flex-end; }
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById('cookie-consent');
    var acceptBtn = document.getElementById('cookie-accept');
    var refuseBtn = document.getElementById('cookie-refuse');

    function showBanner() { banner.hidden = false; }
    function hideBanner() { banner.hidden = true; }

    try {
      if (localStorage.getItem('cookie-consent') === null) {
        showBanner();
      }
    } catch (e) {
      // localStorage unavailable (private mode, blocked storage) — stay hidden rather than nag every load
    }

    acceptBtn.addEventListener('click', function () {
      try { localStorage.setItem('cookie-consent', 'granted'); } catch (e) {}
      hideBanner();
      if (window.__loadGA) window.__loadGA();
    });

    refuseBtn.addEventListener('click', function () {
      try { localStorage.setItem('cookie-consent', 'denied'); } catch (e) {}
      hideBanner();
    });

    // Footer "Gérer les cookies" link (and any future trigger) re-opens the banner
    document.querySelectorAll('[data-open-cookie-settings]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        showBanner();
      });
    });
  })();
</script>
